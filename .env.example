# Flask Configuration
SECRET_KEY=change-this-to-a-secure-random-key-in-production
FLASK_DEBUG=True

# Database Configuration
# Set USE_MYSQL=True to connect to MySQL database
USE_MYSQL=False

# If USE_MYSQL=True, configure below or provide full DATABASE_URL
DB_USER=root
DB_PASSWORD=rootpassword
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_db

# Direct URL override:
# DATABASE_URL=mysql+pymysql://finance_user:finance_password@localhost:3306/finance_db
